// VERSIONINFO for VCamVideoStreamProducer.exe — single source for the file
// properties and the tray "About" box; keep in sync with AppVersion in
// VirtualCameraMediaSource/vcam_installer.iss.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,2,0
 PRODUCTVERSION 0,0,2,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "VCam Video Stream Producer"
            VALUE "FileVersion", "0.0.2.0"
            VALUE "InternalName", "VCamVideoStreamProducer"
            VALUE "LegalCopyright", "VCam Project"
            VALUE "OriginalFilename", "VCamVideoStreamProducer.exe"
            VALUE "ProductName", "VCam Virtual Camera"
            VALUE "ProductVersion", "0.0.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
